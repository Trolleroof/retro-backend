{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tui-gamepigeon.dev/contracts/interaction-trace-chunk-v2.schema.json",
  "title": "Game-agnostic interaction trace chunk v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "user_id",
    "game_id",
    "game_type",
    "game_version",
    "chunk_id",
    "chunk_sequence",
    "first_event_sequence",
    "last_event_sequence",
    "event_count",
    "created_at_ms",
    "client",
    "events"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "user_id": { "type": "string", "pattern": "^usr_[A-Za-z0-9._-]+$" },
    "game_id": { "type": "string", "pattern": "^game_[A-Za-z0-9._-]+$" },
    "game_type": { "type": "string", "minLength": 1 },
    "game_version": { "type": "string", "minLength": 1 },
    "chunk_id": { "type": "string", "pattern": "^chk_[A-Za-z0-9._-]+$" },
    "chunk_sequence": { "type": "integer", "minimum": 1 },
    "first_event_sequence": { "type": "integer", "minimum": 1 },
    "last_event_sequence": { "type": "integer", "minimum": 1 },
    "event_count": { "type": "integer", "minimum": 1 },
    "created_at_ms": { "type": "number", "minimum": 0 },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "application_version", "recording_sdk_version"],
      "properties": {
        "platform": { "const": "tui" },
        "application_version": { "type": "string", "minLength": 1 },
        "recording_sdk_version": { "type": "string", "minLength": 1 }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "user_id",
        "game_id",
        "chunk_id",
        "event_id",
        "event_sequence",
        "event_type",
        "event_version",
        "visibility",
        "client_time_ms",
        "monotonic_time_us",
        "payload"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "user_id": { "type": "string", "pattern": "^usr_[A-Za-z0-9._-]+$" },
        "game_id": { "type": "string", "pattern": "^game_[A-Za-z0-9._-]+$" },
        "chunk_id": { "type": "string", "pattern": "^chk_[A-Za-z0-9._-]+$" },
        "event_id": { "type": "string", "pattern": "^evt_[A-Za-z0-9._-]+$" },
        "event_sequence": { "type": "integer", "minimum": 1 },
        "event_type": {
          "enum": [
            "episode_started",
            "observation",
            "control_changed",
            "control_checkpoint",
            "outcome_changed",
            "engine_checkpoint",
            "episode_ended"
          ]
        },
        "event_version": { "const": 1 },
        "visibility": { "enum": ["policy", "privileged"] },
        "client_time_ms": { "type": "number", "minimum": 0 },
        "monotonic_time_us": { "type": "integer", "minimum": 0 },
        "simulation_tick": { "type": "integer", "minimum": 0 },
        "payload": { "type": "object" }
      }
    }
  }
}
